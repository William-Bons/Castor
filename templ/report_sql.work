    <!--<div id="sqlQueries" style="display:none;">
        <div data-query="val0-7">
            -- ===== ОСНОВНОЙ ЗАПРОС ДЛЯ SQLITE =====
            WITH base_data AS (
            SELECT
            -- Категория поступления
            CASE
            WHEN Datein >= '2026-01-01' AND Datein <= '2026-07-31' THEN 'admitted'
            WHEN Datein >= '2026-01-01' AND Datein <= '2026-07-31' AND First = 1 THEN 'first_admitted'
            WHEN Datein >= '2026-01-01' AND Datein <= '2026-07-31' AND Second = 1 THEN 'second_admitted'
            END AS admission_category,

            -- Категория выписки
            CASE
            WHEN Dateout >= '2026-01-01' AND Dateout <= '2026-07-31' AND Dateout IS NOT NULL THEN 'discharged'
            END AS discharge_category,

            -- Возраст на момент поступления
            CAST(strftime('%Y', Datein) AS INTEGER) - CAST(strftime('%Y', Birthdate) AS INTEGER) -
            CASE WHEN strftime('%m-%d', Datein) < strftime('%m-%d', Birthdate) THEN 1 ELSE 0 END AS AgeIn,

            -- Возраст на момент выписки
            CAST(strftime('%Y', Dateout) AS INTEGER) - CAST(strftime('%Y', Birthdate) AS INTEGER) -
            CASE WHEN strftime('%m-%d', Dateout) < strftime('%m-%d', Birthdate) THEN 1 ELSE 0 END AS AgeOut,

            -- Дополнительные поля
            Deceased,
            Outto,
            Datein,
            Dateout,
            Dsin,
            Dsout,
            First,
            Second,
            Birthdate,
            Id as Movebookid
            FROM Movebooks
            WHERE
            (Datein >= '2026-01-01' AND Datein <= '2026-07-31')
            OR (Dateout >= '2026-01-01' AND Dateout <= '2026-07-31' AND Dateout IS NOT NULL)
            ),

            forced_data AS (
            SELECT
            Movebookid,
            1 AS is_forced
            FROM Forced
            ),

            diagnosis_categories AS (
            SELECT
            b.*,
            -- Категории для Dsin (поступление)
            CASE
            WHEN Dsin LIKE 'F21%' OR Dsin LIKE 'F22%' OR Dsin LIKE 'F23%' OR Dsin LIKE 'F25%'
            OR Dsin LIKE 'F30%' OR Dsin LIKE 'F31%' OR Dsin LIKE 'F32%' OR Dsin LIKE 'F33%'
            OR Dsin LIKE 'F00%' OR Dsin LIKE 'F01%' THEN 'psychosis'
            WHEN Dsin LIKE 'F20%' THEN 'schizophrenia'
            WHEN Dsin LIKE 'F70%' OR Dsin LIKE 'F71%' OR Dsin LIKE 'F72%' OR Dsin LIKE 'F73%' THEN 'mental_retardation'
            WHEN Dsin LIKE 'F02%' OR Dsin LIKE 'F03%' OR Dsin LIKE 'F04%' OR Dsin LIKE 'F05%'
            OR Dsin LIKE 'F06%' OR Dsin LIKE 'F07%' OR Dsin LIKE 'F50%' OR Dsin LIKE 'F60%'
            OR Dsin LIKE 'F61%' OR Dsin LIKE 'F62%' OR Dsin LIKE 'F90%' OR Dsin LIKE 'F91%'
            OR Dsin LIKE 'F40%' OR Dsin LIKE 'F41%' OR Dsin LIKE 'F42%' OR Dsin LIKE 'F43%'
            OR Dsin LIKE 'F45%' OR Dsin LIKE 'F48%' OR Dsin LIKE 'F65%' OR Dsin LIKE 'F88%'
            OR Dsin LIKE 'F84%' THEN 'non_psychotic'
            WHEN Dsin LIKE 'F1%' THEN 'substance_use'
            WHEN Dsin LIKE 'F10%' THEN 'alcoholism'
            WHEN Dsin LIKE 'F11%' OR Dsin LIKE 'F12%' OR Dsin LIKE 'F13%'
            OR Dsin LIKE 'F14%' OR Dsin LIKE 'F15%' OR Dsin LIKE 'F16%'
            OR Dsin LIKE 'F17%' OR Dsin LIKE 'F18%' OR Dsin LIKE 'F19%' THEN 'drug_addiction'
            END AS dsin_category,

            -- Категории для Dsout (выписка)
            CASE
            WHEN Dsout LIKE 'F21%' OR Dsout LIKE 'F22%' OR Dsout LIKE 'F23%' OR Dsout LIKE 'F25%'
            OR Dsout LIKE 'F30%' OR Dsout LIKE 'F31%' OR Dsout LIKE 'F32%' OR Dsout LIKE 'F33%'
            OR Dsout LIKE 'F00%' OR Dsout LIKE 'F01%' THEN 'psychosis'
            WHEN Dsout LIKE 'F20%' THEN 'schizophrenia'
            WHEN Dsout LIKE 'F70%' OR Dsout LIKE 'F71%' OR Dsout LIKE 'F72%' OR Dsout LIKE 'F73%' THEN 'mental_retardation'
            WHEN Dsout LIKE 'F02%' OR Dsout LIKE 'F03%' OR Dsout LIKE 'F04%' OR Dsout LIKE 'F05%'
            OR Dsout LIKE 'F06%' OR Dsout LIKE 'F07%' OR Dsout LIKE 'F50%' OR Dsout LIKE 'F60%'
            OR Dsout LIKE 'F61%' OR Dsout LIKE 'F62%' OR Dsout LIKE 'F90%' OR Dsout LIKE 'F91%'
            OR Dsout LIKE 'F40%' OR Dsout LIKE 'F41%' OR Dsout LIKE 'F42%' OR Dsout LIKE 'F43%'
            OR Dsout LIKE 'F45%' OR Dsout LIKE 'F48%' OR Dsout LIKE 'F65%' OR Dsout LIKE 'F88%'
            OR Dsout LIKE 'F84%' THEN 'non_psychotic'
            WHEN Dsout LIKE 'F1%' THEN 'substance_use'
            WHEN Dsout LIKE 'F10%' THEN 'alcoholism'
            WHEN Dsout LIKE 'F11%' OR Dsout LIKE 'F12%' OR Dsout LIKE 'F13%'
            OR Dsout LIKE 'F14%' OR Dsout LIKE 'F15%' OR Dsout LIKE 'F16%'
            OR Dsout LIKE 'F17%' OR Dsout LIKE 'F18%' OR Dsout LIKE 'F19%' THEN 'drug_addiction'
            END AS dsout_category,

            -- Хронизированные (Datein более года назад от текущей даты)
            CASE WHEN julianday('2026-07-31') - julianday(Datein) > 365 THEN 1 ELSE 0 END AS is_chronic,

            -- На принудительном лечении
            CASE WHEN f.Movebookid IS NOT NULL THEN 1 ELSE 0 END AS is_forced,

            -- На принудительном лечении более года
            CASE
            WHEN f.Movebookid IS NOT NULL AND julianday('2026-07-31') - julianday(Datein) > 365 THEN 1
            ELSE 0
            END AS is_forced_over_year,

            -- Койко-дни
            CASE
            WHEN Dateout IS NOT NULL THEN julianday(Dateout) - julianday(Datein)
            ELSE julianday('2026-07-31') - julianday(Datein)
            END AS bed_days

            FROM base_data b
            LEFT JOIN forced_data f ON b.Movebookid = f.Movebookid
            )

            SELECT
            -- =====================================================
            -- ВЗРОСЛЫЕ (возраст >= 18 лет) - столбцы 01-43
            -- =====================================================

            -- ---- 1. ВСЕ ПОСТУПИВШИЕ ВЗРОСЛЫЕ (столбцы 01-08) ----
            /*01*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 THEN Datein || Dsin END) AS adult_total_admitted,
            /*02*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS adult_psychosis,
            /*03*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS adult_schizophrenia,
            /*04*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS adult_mental_retardation,
            /*05*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS adult_non_psychotic,
            /*06*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS adult_substance_use,
            /*07*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS adult_alcoholism,
            /*08*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn >= 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS adult_drug_addiction,

            -- ---- 2. ПОСТУПИВШИЕ ВПЕРВЫЕ ВЗРОСЛЫЕ (столбцы 09-16) ----
            /*09*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 THEN Datein || Dsin END) AS adult_total_first_admitted,
            /*10*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS adult_first_psychosis,
            /*11*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS adult_first_schizophrenia,
            /*12*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS adult_first_mental_retardation,
            /*13*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS adult_first_non_psychotic,
            /*14*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS adult_first_substance_use,
            /*15*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS adult_first_alcoholism,
            /*16*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn >= 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS adult_first_drug_addiction,

            -- ---- 3. ПОСТУПИВШИЕ ПОВТОРНО ВЗРОСЛЫЕ (столбцы 17-24) ----
            /*17*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 THEN Datein || Dsin END) AS adult_total_second_admitted,
            /*18*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS adult_second_psychosis,
            /*19*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS adult_second_schizophrenia,
            /*20*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS adult_second_mental_retardation,
            /*21*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS adult_second_non_psychotic,
            /*22*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS adult_second_substance_use,
            /*23*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS adult_second_alcoholism,
            /*24*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn >= 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS adult_second_drug_addiction,

            -- ---- 4. ВЫПИСАННЫЕ ВЗРОСЛЫЕ (столбцы 25-32) ----
            /*25*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 THEN Dateout || Dsout END) AS adult_total_discharged,
            /*26*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'psychosis' THEN Dateout || Dsout END) AS adult_discharged_psychosis,
            /*27*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'schizophrenia' THEN Dateout || Dsout END) AS adult_discharged_schizophrenia,
            /*28*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'mental_retardation' THEN Dateout || Dsout END) AS adult_discharged_mental_retardation,
            /*29*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'non_psychotic' THEN Dateout || Dsout END) AS adult_discharged_non_psychotic,
            /*30*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'substance_use' THEN Dateout || Dsout END) AS adult_discharged_substance_use,
            /*31*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'alcoholism' THEN Dateout || Dsout END) AS adult_discharged_alcoholism,
            /*32*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut >= 18 AND dsout_category = 'drug_addiction' THEN Dateout || Dsout END) AS adult_discharged_drug_addiction,

            -- ---- 5. ДОПОЛНИТЕЛЬНЫЕ ПОКАЗАТЕЛИ ВЗРОСЛЫЕ (столбцы 33-43) ----
            /*33*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND Deceased = 1 THEN Movebookid END) AS adult_deceased,
            /*34*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND is_chronic = 1 THEN Movebookid END) AS adult_chronic,
            /*35*/ SUM(CASE WHEN AgeIn >= 18 THEN bed_days ELSE 0 END) AS adult_bed_days,
            /*36*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND Outto = 3 THEN Movebookid END) AS adult_transferred_pni,
            /*37*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND is_chronic = 1 AND Dateout IS NULL THEN Movebookid END) AS adult_chronic_in_department,
            /*38*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND is_forced = 1 THEN Movebookid END) AS adult_forced,
            /*39*/ COUNT(DISTINCT CASE WHEN AgeIn >= 18 AND is_forced_over_year = 1 THEN Movebookid END) AS adult_forced_over_year,
            /*40*/ 0 AS adult_unvoluntary,
            /*41*/ 0 AS adult_unvoluntary_court,
            /*42*/ 0 AS adult_mse_documents,
            /*43*/ 0 AS adult_accidents,

            -- =====================================================
            -- НЕСОВЕРШЕННОЛЕТНИЕ (возраст < 18 лет) - столбцы 44-86
            -- =====================================================

            -- ---- 6. ВСЕ ПОСТУПИВШИЕ НЕСОВЕРШЕННОЛЕТНИЕ (столбцы 44-51) ----
            /*44*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 THEN Datein || Dsin END) AS minor_total_admitted,
            /*45*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS minor_psychosis,
            /*46*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS minor_schizophrenia,
            /*47*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS minor_mental_retardation,
            /*48*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS minor_non_psychotic,
            /*49*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS minor_substance_use,
            /*50*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS minor_alcoholism,
            /*51*/ COUNT(DISTINCT CASE WHEN admission_category = 'admitted' AND AgeIn < 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS minor_drug_addiction,

            -- ---- 7. ПОСТУПИВШИЕ ВПЕРВЫЕ НЕСОВЕРШЕННОЛЕТНИЕ (столбцы 52-59) ----
            /*52*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 THEN Datein || Dsin END) AS minor_total_first_admitted,
            /*53*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS minor_first_psychosis,
            /*54*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS minor_first_schizophrenia,
            /*55*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS minor_first_mental_retardation,
            /*56*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS minor_first_non_psychotic,
            /*57*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS minor_first_substance_use,
            /*58*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS minor_first_alcoholism,
            /*59*/ COUNT(DISTINCT CASE WHEN admission_category = 'first_admitted' AND AgeIn < 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS minor_first_drug_addiction,

            -- ---- 8. ПОСТУПИВШИЕ ПОВТОРНО НЕСОВЕРШЕННОЛЕТНИЕ (столбцы 60-67) ----
            /*60*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 THEN Datein || Dsin END) AS minor_total_second_admitted,
            /*61*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'psychosis' THEN Datein || Dsin END) AS minor_second_psychosis,
            /*62*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'schizophrenia' THEN Datein || Dsin END) AS minor_second_schizophrenia,
            /*63*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'mental_retardation' THEN Datein || Dsin END) AS minor_second_mental_retardation,
            /*64*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'non_psychotic' THEN Datein || Dsin END) AS minor_second_non_psychotic,
            /*65*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'substance_use' THEN Datein || Dsin END) AS minor_second_substance_use,
            /*66*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'alcoholism' THEN Datein || Dsin END) AS minor_second_alcoholism,
            /*67*/ COUNT(DISTINCT CASE WHEN admission_category = 'second_admitted' AND AgeIn < 18 AND dsin_category = 'drug_addiction' THEN Datein || Dsin END) AS minor_second_drug_addiction,

            -- ---- 9. ВЫПИСАННЫЕ НЕСОВЕРШЕННОЛЕТНИЕ (столбцы 68-75) ----
            /*68*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 THEN Dateout || Dsout END) AS minor_total_discharged,
            /*69*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'psychosis' THEN Dateout || Dsout END) AS minor_discharged_psychosis,
            /*70*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'schizophrenia' THEN Dateout || Dsout END) AS minor_discharged_schizophrenia,
            /*71*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'mental_retardation' THEN Dateout || Dsout END) AS minor_discharged_mental_retardation,
            /*72*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'non_psychotic' THEN Dateout || Dsout END) AS minor_discharged_non_psychotic,
            /*73*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'substance_use' THEN Dateout || Dsout END) AS minor_discharged_substance_use,
            /*74*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'alcoholism' THEN Dateout || Dsout END) AS minor_discharged_alcoholism,
            /*75*/ COUNT(DISTINCT CASE WHEN discharge_category = 'discharged' AND AgeOut < 18 AND dsout_category = 'drug_addiction' THEN Dateout || Dsout END) AS minor_discharged_drug_addiction,

            -- ---- 10. ДОПОЛНИТЕЛЬНЫЕ ПОКАЗАТЕЛИ НЕСОВЕРШЕННОЛЕТНИЕ (столбцы 76-86) ----
            /*76*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND Deceased = 1 THEN Movebookid END) AS minor_deceased,
            /*77*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND is_chronic = 1 THEN Movebookid END) AS minor_chronic,
            /*78*/ SUM(CASE WHEN AgeIn < 18 THEN bed_days ELSE 0 END) AS minor_bed_days,
            /*79*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND Outto = 3 THEN Movebookid END) AS minor_transferred_pni,
            /*80*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND is_chronic = 1 AND Dateout IS NULL THEN Movebookid END) AS minor_chronic_in_department,
            /*81*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND is_forced = 1 THEN Movebookid END) AS minor_forced,
            /*82*/ COUNT(DISTINCT CASE WHEN AgeIn < 18 AND is_forced_over_year = 1 THEN Movebookid END) AS minor_forced_over_year,
            /*83*/ 0 AS minor_unvoluntary,
            /*84*/ 0 AS minor_unvoluntary_court,
            /*85*/ 0 AS minor_mse_documents,
            /*86*/ 0 AS minor_accidents

            FROM diagnosis_categories;
        </div>
    </div>-->
