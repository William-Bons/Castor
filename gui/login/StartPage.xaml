<Page x:Class="Castor.gui.login.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage"
      Background="#F5F7FA">

    <Page.Resources>
        <!-- Стиль для карточек модулей -->
        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для иконок -->
        <Style x:Key="ModuleIconStyle" TargetType="Image">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Добро пожаловать!" 
                           FontSize="28" 
                           FontWeight="SemiBold" 
                           Foreground="#2C3E50"/>
                <TextBlock Text="Выберите модуль для работы" 
                           FontSize="16" 
                           Foreground="#7F8C8D" 
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Карточки с иконками из ресурсов -->
            <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,10,0,0">

                <!-- 1. Движение пациентов -->
                <Border Style="{StaticResource ModuleCardStyle}" 
                        MouseLeftButtonDown="PatientsMovement_Click" Tag="Castor.gui.movebook.Thebook">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/img/2afb7fb.jpeg" 
                               Style="{StaticResource ModuleIconStyle}"/>
                        <TextBlock Text="Движение пациентов" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,5,0,5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Маршруты и перемещения" 
                                   FontSize="13" 
                                   Foreground="#95A5A6"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 2. Принудительное лечение -->
                <Border Style="{StaticResource ModuleCardStyle}"
                        MouseLeftButtonDown="PatientsMovement_Click" Tag="Castor.gui.force.MonthsPanel">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/img/f6f30_1.jpeg" 
                               Style="{StaticResource ModuleIconStyle}"/>
                        <TextBlock Text="Принудительное лечение" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,5,0,5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Назначения и контроль" 
                                   FontSize="13" 
                                   Foreground="#95A5A6"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 3. Отчеты -->
                <Border Style="{StaticResource ModuleCardStyle}"
                        MouseLeftButtonDown="PatientsMovement_Click" Tag="Castor.gui.reports.DisplayReport">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/img/fol-0.jpg" 
                               Style="{StaticResource ModuleIconStyle}"/>
                        <TextBlock Text="Отчеты" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,5,0,5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Статистика и аналитика" 
                                   FontSize="13" 
                                   Foreground="#95A5A6"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 4. Настройки -->
                <Border Style="{StaticResource ModuleCardStyle}"
                        MouseLeftButtonDown="PatientsMovement_Click" Tag="Castor.gui.dialogs.SettingsCheet">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/img/a398.jpeg" 
                               Style="{StaticResource ModuleIconStyle}"/>
                        <TextBlock Text="Настройки" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,5,0,5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Параметры системы" 
                                   FontSize="13" 
                                   Foreground="#95A5A6"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Grid>
</Page>