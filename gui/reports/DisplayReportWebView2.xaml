<Page x:Class="Castor.gui.reports.DisplayReportWebView2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="DisplayReportWebView2"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="🔄 Обновить" Click="RefreshButton_Click" Margin="3" Padding="8,4" ToolTip="Обновить данные отчета"/>
                <Button Content="🖨️ Печать" Click="PrintButton_Click" Margin="3" Padding="8,4" ToolTip="Печать"/>
                <Button Content="📄 Предпросмотр" Click="PrintPreviewButton_Click" Margin="3" Padding="8,4" ToolTip="Предварительный просмотр печати"/>
                <Button Content="📎 Параметры" Command="{Binding UpdateParameters}" Margin="3" Padding="8,4" ToolTip="Настроить параметры отчета"/>
                <Separator Width="2" Background="#CCCCCC" Margin="5,0"/>
                <TextBlock Text="Отчет:" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold"/>
                <!--<ComboBox x:Name="ReportList" Width="250" Margin="3" 
                          SelectionChanged="ReportList_SelectionChanged"
                          ToolTip="Выберите отчет для загрузки"/>-->
                <TextBlock x:Name="StatusText" Text="Готов" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="#666666" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- WebView2 Browser -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Page>